FROM rust:1.78-bookworm as builder

WORKDIR /app

# Copy stale core (path dependency)
COPY ../stale-enterprise /app/stale-enterprise
COPY backend/Cargo.toml /app/backend/Cargo.toml
COPY backend/src /app/backend/src

WORKDIR /app/backend

# Build release
RUN cargo build --release

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/backend/target/release/stale-enterprise-api /usr/local/bin/stale-enterprise-api

ENV PORT=3001
EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD curl -f http://localhost:3001/health || exit 1

CMD ["stale-enterprise-api"]
